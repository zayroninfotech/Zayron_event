SECRET_KEY=your-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=your-server-ip,localhost,127.0.0.1
SITE_URL=http://your-server-ip:8023

# MongoDB - use full URI
MONGO_URI=mongodb://mongouser:mongopassword@your-server-ip:27018/?authSource=admin
MONGO_DB=zayrosnap

# Fallback individual settings (used only if MONGO_URI is empty)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin

# Celery broker
CELERY_BROKER_URL=memory://

# Face recognition tolerance
FACE_MATCH_TOLERANCE=0.5
